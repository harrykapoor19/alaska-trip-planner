# Group sync (server-side, set in Vercel project env — NOT committed).
# A shared secret you invent and text to the group. Gates read/write to the
# shared trip blob. Any string.
TRIP_CODE=

# Provisioned automatically when you add Upstash Redis via the Vercel
# Marketplace (Storage tab) — you don't set these by hand.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Gmail booking search (client-side, public — safe to expose in the bundle).
# Google OAuth *client ID* (not the secret) from Google Cloud Console.
# Leave unset to hide the Gmail feature entirely.
VITE_GOOGLE_CLIENT_ID=
